@* Small inline line icons (no icon font or external dependency). *@
<svg class="icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "cart":
            <circle cx="9" cy="20" r="1.5" /><circle cx="18" cy="20" r="1.5" />
            <path d="M2.5 3h2.6l2.4 11.2a1.5 1.5 0 0 0 1.5 1.2h8.6a1.5 1.5 0 0 0 1.5-1.1L21 7H6.1" />
            break;
        case "sync":
            <path d="M20 11a8 8 0 0 0-14.6-4.5L4 8" /><path d="M4 3v5h5" />
            <path d="M4 13a8 8 0 0 0 14.6 4.5L20 16" /><path d="M20 21v-5h-5" />
            break;
        case "invoice":
            <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" />
            <path d="M9 13h6" /><path d="M9 17h4" />
            break;
        case "check":
            <path d="M5 12.5l4.5 4.5L19 7.5" />
            break;
        case "check-circle":
            <circle cx="12" cy="12" r="9" /><path d="M8.5 12.5l2.5 2.5 4.5-5" />
            break;
        case "alert":
            <path d="M12 3.5 2.5 20h19z" /><path d="M12 10v4" /><path d="M12 17h.01" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
            break;
        case "shield":
            <path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.3 7.5 9.5 4.3-1.2 7.5-4.9 7.5-9.5V6z" /><path d="M9 12l2 2 4-4" />
            break;
        case "arrow-right":
            <path d="M5 12h14" /><path d="M13 6l6 6-6 6" />
            break;
        case "arrow-left":
            <path d="M19 12H5" /><path d="M11 18l-6-6 6-6" />
            break;
        case "external":
            <path d="M14 4h6v6" /><path d="M20 4l-9 9" /><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
            break;
        case "plus":
            <path d="M12 5v14" /><path d="M5 12h14" />
            break;
        case "bolt":
            <path d="M13 2 4 14h7l-1 8 9-12h-7z" />
            break;
        case "info":
            <circle cx="12" cy="12" r="9" /><path d="M12 11v5" /><path d="M12 8h.01" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    [Parameter] public int Size { get; set; } = 18;

    [Parameter] public string? Class { get; set; }
}
