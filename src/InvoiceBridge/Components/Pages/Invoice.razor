@page "/facturen/{OrderId}"
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Caching.Memory
@using Microsoft.Extensions.Options
@using InvoiceBridge.Clients
@using InvoiceBridge.Data
@using InvoiceBridge.MockShop
@using InvoiceBridge.Models
@using InvoiceBridge.Options
@using InvoiceBridge.Services
@inject InvoiceBridgeDbContext Db
@inject MockOrderStore Shop
@inject IOptions<DemoOptions> DemoOptions
@inject IOptions<MoneybirdOptions> MoneybirdOptions
@inject IHttpContextAccessor HttpContextAccessor
@inject AdminAuthService AdminAuth
@inject IMoneybirdClient MoneybirdClient
@inject IMemoryCache Cache
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["Invoice_PageTitle", OrderId]</PageTitle>

<div class="invoice-page">
    <div class="invoice-toolbar">
        <a class="btn btn-ghost btn-sm" href="demo"><Icon Name="arrow-left" Size="16" /> @L["Invoice_Back"]</a>
        @if (_isAdmin && order?.MoneybirdInvoiceId is not null && order.Status == SyncStatus.Synced)
        {
            <a class="btn btn-secondary btn-sm" href="@MoneybirdUrl(order.MoneybirdInvoiceId)" target="_blank" rel="noopener">
                @L["Invoice_OpenMoneybird"] <Icon Name="external" Size="15" />
            </a>
        }
    </div>

    @if (order is null)
    {
        <div class="card empty-state">
            <span class="icon-badge"><Icon Name="invoice" /></span>
            <h1>@L["Invoice_NotFound_Title"]</h1>
            <p>@L["Invoice_NotFound_Desc", OrderId]</p>
            <a class="btn btn-primary" href="demo">@L["Invoice_ToDemoBtn"]</a>
        </div>
    }
    else if (order.Status is not SyncStatus.Synced and not SyncStatus.Simulated)
    {
        <div class="card empty-state">
            <span class="icon-badge icon-badge-warning"><Icon Name="clock" /></span>
            <h1>@L["Invoice_NotReady_Title"]</h1>
            <p>@L["Invoice_NotReady_Desc", order.OrderId]</p>
            <StatusBadge Status="order.Status" />
            @if (order.LastError is not null && order.Status == SyncStatus.Failed)
            {
                <p>@order.LastError</p>
            }
            <a class="btn btn-primary" href="demo">@L["Invoice_ToDemoBtn"]</a>
        </div>
    }
    else if (lines.Count == 0)
    {
        <div class="card empty-state">
            <span class="icon-badge"><Icon Name="invoice" /></span>
            <h1>@L["Invoice_Loading_Title"]</h1>
            <p>@L["Invoice_Loading_Desc"]</p>
        </div>
    }
    else
    {
        @if (order.Status == SyncStatus.Synced)
        {
            <div class="notice notice-success">
                <Icon Name="check-circle" />
                <span>@L["Invoice_Synced_Notice", Display.DateAndTime(order.SyncedAt)]</span>
            </div>
            @if (_moneybirdDetails is not null)
            {
                <div class="notice notice-info" style="font-size: 0.875rem;">
                    <Icon Name="external" Size="15" />
                    <span>
                        <strong>@L["Invoice_Moneybird_Heading"]</strong> &nbsp;·&nbsp;
                        @L["Invoice_ID_Label"] <span class="mono">@(_moneybirdDetails.InvoiceId ?? order.MoneybirdInvoiceId)</span>
                        &nbsp;·&nbsp; @L["Invoice_Moneybird_Status"] @_moneybirdDetails.StateLabel
                        &nbsp;·&nbsp; @L["Invoice_Moneybird_Created"] @Display.DateAndTime(_moneybirdDetails.CreatedAt)
                        @if (!_isAdmin)
                        {
                            <br />@L["Invoice_Moneybird_VisitorNote"]
                        }
                    </span>
                </div>
            }
        }
        else
        {
            <div class="notice notice-info">
                <Icon Name="info" />
                <span>@L["Invoice_Simulated_Notice"]</span>
            </div>
        }

        <article class="card invoice-paper" aria-label="Factuur">
            <header class="invoice-top">
                <div class="invoice-company">
                    <strong>Koffiehuis De Demo</strong>
                    <p>Voorbeeldstraat 1, 1234 AB Demostad<br />Fictief demobedrijf</p>
                </div>
                <div class="invoice-title">
                    <h1>@(order.Status == SyncStatus.Simulated ? L["Invoice_Simulated_Title"].Value : L["Invoice_Draft_Title"].Value)</h1>
                    <StatusBadge Status="order.Status" />
                    <dl class="invoice-meta">
                        <dt>@L["Invoice_Ref"]</dt><dd class="mono">@order.OrderId</dd>
                        <dt>@L["Invoice_Date"]</dt><dd>@Display.Date(invoiceDate)</dd>
                    </dl>
                </div>
            </header>

            <div class="invoice-to">
                <span>@L["Invoice_BillTo"]</span>
                <strong>@customerName</strong>
            </div>

            <table class="invoice-lines">
                <thead>
                    <tr>
                        <th>@L["Invoice_Col_Description"]</th>
                        <th class="num col-qty">@L["Invoice_Col_Qty"]</th>
                        <th class="num col-price">@L["Invoice_Col_Price"]</th>
                        <th class="num">@L["Invoice_Col_Amount"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in lines)
                    {
                        <tr>
                            <td>
                                @line.Description
                                <span class="line-detail">@line.Quantity × @Display.Amount(line.UnitPrice)</span>
                            </td>
                            <td class="num col-qty">@line.Quantity</td>
                            <td class="num col-price">@Display.Amount(line.UnitPrice)</td>
                            <td class="num">@Display.Amount(line.LineTotal)</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="invoice-total">
                <dl>
                    <dt class="grand">@L["Invoice_Total"]</dt>
                    <dd class="grand">@Display.Amount(lines.Sum(l => l.LineTotal))</dd>
                </dl>
            </div>
            <p class="invoice-vat">@L["Invoice_VatNote"]</p>

            <footer class="invoice-footnote">
                <Icon Name="info" Size="16" />
                <span>@L["Invoice_Footnote"]</span>
            </footer>
        </article>
    }
</div>

@code {
    [Parameter] public string OrderId { get; set; } = "";

    private static readonly TimeSpan DetailsCacheDuration = TimeSpan.FromMinutes(5);

    private SyncedOrder? order;
    private List<InvoiceLine> lines = [];
    private string? customerName;
    private DateOnly? invoiceDate;
    private bool _isAdmin;
    private MoneybirdInvoiceDetails? _moneybirdDetails;

    protected override async Task OnParametersSetAsync()
    {
        _isAdmin = AdminAuth.IsAdmin(HttpContextAccessor.HttpContext);

        order = await Db.SyncedOrders
            .AsNoTracking()
            .Include(o => o.InvoiceLines)
            .SingleOrDefaultAsync(o => o.OrderId == OrderId);
        if (order is null)
        {
            return;
        }

        lines = order.InvoiceLines.OrderBy(l => l.Id).ToList();
        customerName = order.CustomerName;
        invoiceDate = order.InvoiceDate;

        // Orders invoiced before snapshots existed: show the webshop order until the worker fills in the snapshot.
        if (lines.Count == 0 && Shop.Find(order.OrderId) is { } shopOrder)
        {
            lines = shopOrder.Lines
                .Select(l => new InvoiceLine { Description = l.Product, Quantity = l.Quantity, UnitPrice = l.UnitPrice })
                .ToList();
            customerName = shopOrder.CustomerName;
            invoiceDate = DateOnly.FromDateTime(shopOrder.OrderDate.Date);
        }

        // Fetch live Moneybird details to confirm the invoice is real — only for truly synced invoices.
        _moneybirdDetails = null;
        if (order.Status == SyncStatus.Synced && order.MoneybirdInvoiceId is { } invoiceId && MoneybirdClient.IsConfigured)
        {
            var cacheKey = $"moneybird:invoice:{invoiceId}";
            if (!Cache.TryGetValue(cacheKey, out MoneybirdInvoiceDetails? cached))
            {
                try
                {
                    cached = await MoneybirdClient.GetInvoiceAsync(invoiceId);
                    Cache.Set(cacheKey, cached, DetailsCacheDuration);
                }
                catch
                {
                    // Silently skip if Moneybird is unavailable — don't break the invoice page.
                    cached = null;
                }
            }
            _moneybirdDetails = cached;
        }
    }

    private string MoneybirdUrl(string invoiceId) =>
        $"https://moneybird.com/{Uri.EscapeDataString(MoneybirdOptions.Value.AdministrationId ?? "")}/sales_invoices/{Uri.EscapeDataString(invoiceId)}";
}
