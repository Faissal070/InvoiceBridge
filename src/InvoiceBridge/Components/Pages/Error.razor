@page "/Error"
@using System.Diagnostics

<PageTitle>Er ging iets mis – InvoiceBridge</PageTitle>

<div class="card empty-state">
    <span class="icon-badge icon-badge-warning"><Icon Name="alert" /></span>
    <h1>Er ging iets mis</h1>
    <p>Deze pagina kon even niet worden geladen. Probeer het opnieuw, of ga terug naar het begin.</p>
    @if (ShowRequestId)
    {
        <p class="subtle">Foutcode: <span class="mono">@RequestId</span></p>
    }
    <a class="btn btn-primary" href="">Naar de homepagina</a>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
