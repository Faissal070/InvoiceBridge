@inherits LayoutComponentBase
@inject IStringLocalizer<SharedResources> L
@inject IHttpContextAccessor HttpContextAccessor

<a class="skip-link" href="#main">@L["SkipToContent"]</a>

<header class="topbar">
    <div class="container topbar-inner">
        <a class="brand" href="">
            <span class="brand-mark" aria-hidden="true"><Icon Name="sync" Size="16" /></span>
            OrderSync
        </a>
        <nav class="topnav" aria-label="Hoofdmenu">
            <NavLink href="" Match="NavLinkMatch.All">@L["Nav_HowItWorks"]</NavLink>
            <NavLink href="demo" class="topnav-cta">@L["Nav_LiveDemo"]</NavLink>
        </nav>
        <div class="lang-switcher" aria-label="Taal / Language">
            @* Full page load: enhanced navigation would keep interactive components on the old culture. *@
            <a href="/set-culture/nl" data-enhance-nav="false" class="lang-btn @(IsNl ? "lang-btn-active" : null)">NL</a>
            <a href="/set-culture/en" data-enhance-nav="false" class="lang-btn @(!IsNl ? "lang-btn-active" : null)">EN</a>
        </div>
    </div>
</header>

<main id="main" class="container page">
    @Body
</main>

<footer class="footer">
    <div class="container footer-inner">
        <span>@L["Footer_DemoNote"]</span>
        <span>OrderSync</span>
    </div>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    @L["Error_Message"] <a href="." class="reload">@L["Error_Reload"]</a>
    <button class="dismiss" type="button" aria-label="@L["Error_Dismiss"]">×</button>
</div>

@code {
    private bool IsNl => HttpContextAccessor.HttpContext?.Request.Cookies["lang"] is not "en";
}
