@page "/dashboard"
@rendermode InteractiveServer
@implements IDisposable
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using OrderSync.Data
@using OrderSync.Models
@using OrderSync.Options
@using OrderSync.Services
@inject IServiceScopeFactory ScopeFactory
@inject IOptions<MoneybirdOptions> MoneybirdOptions
@inject IOptions<DemoOptions> DemoOptions
@inject OrderChangeNotifier Notifier
@inject VisitorContext Visitor
@inject ILogger<Dashboard> Logger

<PageTitle>Dashboard</PageTitle>

<h1>Sync dashboard</h1>

@if (!MoneybirdOptions.Value.IsConfigured)
{
    <div class="alert alert-warning">
        Moneybird is niet geconfigureerd. Zet <code>Moneybird:Token</code> en
        <code>Moneybird:AdministrationId</code> in user-secrets; bestellingen worden tot dan niet gefactureerd.
    </div>
}

<div class="d-flex flex-wrap gap-2 mb-3">
    <button class="btn btn-outline-secondary" @onclick="RefreshAsync" disabled="@busy">Vernieuwen</button>
    <button class="btn btn-primary" @onclick="() => PlaceOrderAsync(simulateOutage: false)" disabled="@busy">Nieuwe bestelling plaatsen</button>
    <button class="btn btn-outline-warning" @onclick="() => PlaceOrderAsync(simulateOutage: true)" disabled="@busy">Bestelling met storing</button>
</div>

@if (message is not null)
{
    <div class="alert @(messageIsError ? "alert-danger" : "alert-info")">@message</div>
}

@if (orders is null)
{
    <p><em>Laden...</em></p>
}
else
{
    <div class="d-flex flex-wrap gap-3 mb-3">
        @foreach (var status in Enum.GetValues<SyncStatus>())
        {
            <div class="card text-center" style="min-width: 8rem">
                <div class="card-body">
                    <div class="fs-3 fw-bold">@orders.Count(o => o.Status == status)</div>
                    <span class="badge @BadgeClass(status)">@Label(status)</span>
                </div>
            </div>
        }
    </div>

    @if (orders.Count == 0)
    {
        <p>Nog geen bestellingen gesynchroniseerd.</p>
    }
    else
    {
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Klant</th>
                    <th>Bedrag</th>
                    <th>Status</th>
                    <th>Pogingen</th>
                    <th>Laatste poging</th>
                    <th>Reden mislukt</th>
                    <th>Moneybird-factuur</th>
                    <th>Gefactureerd op</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in orders)
                {
                    <tr class="@(order.Status == SyncStatus.Failed ? "table-danger" : null)">
                        <td>@order.OrderId</td>
                        <td>@order.CustomerName</td>
                        <td>@FormatAmount(order.Total)</td>
                        <td><span class="badge @BadgeClass(order.Status)">@Label(order.Status)</span></td>
                        <td>@order.Attempts</td>
                        <td>@FormatDate(order.LastAttemptAt)</td>
                        <td class="small">@(order.Status == SyncStatus.Failed ? order.LastError : null)</td>
                        <td>
                            @if (order.MoneybirdInvoiceId is not null && DemoOptions.Value.ShowMoneybirdLinks)
                            {
                                <a href="@InvoiceUrl(order.MoneybirdInvoiceId)" target="_blank" rel="noopener">Bekijk factuur</a>
                            }
                        </td>
                        <td>@FormatDate(order.SyncedAt)</td>
                        <td>
                            @if (order.Status == SyncStatus.Failed)
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RetryAsync(order)" disabled="@busy">
                                    Opnieuw proberen
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private static readonly TimeSpan AutoRefreshInterval = TimeSpan.FromSeconds(15);
    private static readonly CultureInfo Dutch = CultureInfo.GetCultureInfo("nl-NL");

    private List<SyncedOrder>? orders;
    private string? message;
    private bool messageIsError;
    private bool busy;
    private Timer? refreshTimer;
    private int refreshQueued;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        Notifier.Changed += OnOrdersChanged;
        // Fallback in case a change notification is missed.
        refreshTimer = new Timer(_ => OnOrdersChanged(), null, AutoRefreshInterval, AutoRefreshInterval);
    }

    public void Dispose()
    {
        Notifier.Changed -= OnOrdersChanged;
        refreshTimer?.Dispose();
    }

    /// <summary>Reloads once for a burst of changes; called from other threads.</summary>
    private void OnOrdersChanged()
    {
        if (Interlocked.Exchange(ref refreshQueued, 1) == 1)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            Volatile.Write(ref refreshQueued, 0);
            try
            {
                await LoadAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Refreshing the dashboard failed");
            }
        });
    }

    private async Task RefreshAsync()
    {
        message = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<OrderSyncDbContext>();
        orders = await db.SyncedOrders
            .AsNoTracking()
            .OrderByDescending(o => o.CreatedAt)
            .ThenByDescending(o => o.OrderId)
            .ToListAsync();
    }

    private Task PlaceOrderAsync(bool simulateOutage) => RunAsync("Bestelling plaatsen", async services =>
    {
        var placed = await services.GetRequiredService<DemoOrderService>().PlaceOrderAsync(Visitor.VisitorId, simulateOutage);
        if (!placed.Accepted)
        {
            message = placed.RefusedReason;
            messageIsError = true;
            return;
        }

        var orderId = placed.Order!.OrderId;
        message = $"Bestelling {orderId} van {placed.Order.CustomerName} ontvangen. Factuur wordt aangemaakt...";
        StateHasChanged();

        await services.GetRequiredService<OrderInvoicingService>().InvoiceOrderAsync(placed.SyncedOrderId!.Value);
        await LoadAsync();
        var order = orders!.Single(o => o.Id == placed.SyncedOrderId);
        messageIsError = order.Status == SyncStatus.Failed;
        message = order.Status switch
        {
            SyncStatus.Synced => $"Bestelling {orderId} is gefactureerd.",
            SyncStatus.Failed => $"Bestelling {orderId} kon nog niet worden gefactureerd: {order.LastError}",
            _ => $"Bestelling {orderId} wordt gefactureerd."
        };
    });

    private Task RetryAsync(SyncedOrder order) => RunAsync($"Opnieuw proberen {order.OrderId}", async services =>
    {
        var result = await services.GetRequiredService<DemoOrderService>().RetryAsync(Visitor.VisitorId, order.Id);
        message = result switch
        {
            { Attempted: false } => result.RefusedReason,
            { Synced: true } => $"{order.OrderId} is gefactureerd.",
            _ => $"{order.OrderId} is opnieuw mislukt; zie de reden in de tabel."
        };
        messageIsError = !result.Synced;
    });

    private async Task RunAsync(string action, Func<IServiceProvider, Task> work)
    {
        busy = true;
        message = null;
        messageIsError = false;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await work(scope.ServiceProvider);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "{Action} failed", action);
            message = $"{action} mislukt. Probeer het later opnieuw.";
            messageIsError = true;
        }
        finally
        {
            await LoadAsync();
            busy = false;
        }
    }

    private string InvoiceUrl(string invoiceId) =>
        $"https://moneybird.com/{Uri.EscapeDataString(MoneybirdOptions.Value.AdministrationId ?? "")}/sales_invoices/{Uri.EscapeDataString(invoiceId)}";

    private static string? FormatDate(DateTimeOffset? date) => date?.ToLocalTime().ToString("dd-MM-yyyy HH:mm");

    private static string? FormatAmount(decimal? amount) => amount?.ToString("C", Dutch);

    private static string Label(SyncStatus status) => status switch
    {
        SyncStatus.Pending => "Wachtend",
        SyncStatus.Processing => "Bezig",
        SyncStatus.Synced => "Gefactureerd",
        SyncStatus.Failed => "Mislukt",
        _ => status.ToString()
    };

    private static string BadgeClass(SyncStatus status) => status switch
    {
        SyncStatus.Synced => "bg-success",
        SyncStatus.Failed => "bg-danger",
        SyncStatus.Processing => "bg-info text-dark",
        _ => "bg-warning text-dark"
    };
}
